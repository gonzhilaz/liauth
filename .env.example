# Sentinel Universal License Authority Environment Config

# Master Passcode for developer dashboard login
MASTER_DEV_PASSCODE=developer-root-secure-2026

# Ed25519 Master Signing Keys (32-byte hex)
# KEEP PRIVATE KEY ABSOLUTELY SECRET!
DEV_PRIVATE_KEY=59886c805cfb34fe921c8ef9b552c945ed735aa42474064d73db3e8636905720
DEV_PUBLIC_KEY=0c3b91b33c1596b8af5110b0c72074960cc25e92e0137628661d13a2ee6e8770

# Public URL of this Sentinel instance on Vercel
NEXT_PUBLIC_VERIFY_URL=https://license.yourdomain.vercel.app/api/verify

# (Optional) Upstash Redis / Vercel KV for global multi-region persistence
# If omitted, Sentinel runs in fast zero-setup in-memory / edge persistence mode.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
